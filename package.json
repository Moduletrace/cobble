{
    "name": "cobble",
    "version": "0.7.2",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun src/server.ts",
        "gen:favicon": "bun src/scripts/generate-brand-assets.ts",
        "build": "bunx bunext build",
        "db:schema": "bunx bun-sqlite schema -t -y",
        "db:admin": "bunx bun-sqlite admin",
        "db:backup": "bunx bun-sqlite backup",
        "seed": "bun src/scripts/seed-super-admin.tsx",
        "seed:bots": "bun src/scripts/seed-bots.ts",
        "start": "MAIN_SERVER=1 NODE_ENV=production bun src/server.ts",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "check:bundle": "bun src/scripts/check-bundle-size.ts",
        "publish:github": "bash scripts/publish-github.sh",
        "publish:gitea": "bash scripts/publish-gitea.sh",
        "mirror:gitea": "bash scripts/mirror-gitea.sh"
    },
    "devDependencies": {
