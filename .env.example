PORT=7227

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_DOMAIN=
EMAIL_USER=
EMAIL_PASS=
# Receives contact form submissions
CONTACT_EMAIL_RECIPIENT=
# Outside production, ALL outgoing mail is redirected here (leave empty to skip sending)
DEV_EMAIL_RECIPIENT=

ENCRYPTION_KEY=
ENCRYPTION_SALT=

SOURCE_DIRECTORY=/home/user/projects/bunext-sqlite
DEPLOY_SERVER_IP=192.168.5.27

DATA_DIR=/data

# Set to 1 on the one container that should run cron tasks in production
MAIN_SERVER=

# Optional public envs exposed to the client through __root.server.ts
PAYSTACK_PUBLIC_KEY=
R2_PUBLIC_DOMAIN=

# Seed script overrides (bun run seed)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_USERNAME=
SEED_SUPER_ADMIN_FIRST_NAME=
SEED_SUPER_ADMIN_LAST_NAME=
SEED_SUPER_ADMIN_PASSWORD=

# Production: sitemap lastmod cache file on the /data volume
PAGE_LASTMOD_FILE=
