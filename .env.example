# Development settings. The installer writes its own .env; see README.md.

PORT=7227

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP host, user and password
EMAIL_DOMAIN=
EMAIL_USER=
EMAIL_PASS=
# Receives contact form submissions
CONTACT_EMAIL_RECIPIENT=
# Outside production, ALL outgoing mail is redirected here (leave empty to skip sending)
DEV_EMAIL_RECIPIENT=

ENCRYPTION_KEY=
ENCRYPTION_SALT=

# HTTPS (optional in development; see README). Generate files with
# `bun run gen:certs` and point these at them. The installer sets them on a
# real install. Leave all three empty to serve plain HTTP.
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=
# Plain-HTTP port that redirects to the HTTPS one (default PORT + 1).
DEV_HTTP_PORT=

# Web Push: generated into Settings > Environment on first start. Set a
# fixed pair here only if you want to keep one across installs.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Seed script overrides (bun run seed)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_USERNAME=
SEED_SUPER_ADMIN_FIRST_NAME=
SEED_SUPER_ADMIN_LAST_NAME=
SEED_SUPER_ADMIN_PASSWORD=
